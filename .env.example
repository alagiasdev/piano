# Copia questo file in .env e compila i valori.
# Il .env non va mai messo sotto controllo di versione ne dentro public/.

APP_NAME="Piano"
APP_ENV=local
APP_DEBUG=true

# URL base pubblico dell'applicazione, senza slash finale.
# In locale (XAMPP):  http://localhost/crm_social1.0/public
# Su cPanel:          https://piano.iltuodominio.it
APP_URL="http://localhost/crm_social1.0/public"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=piano
DB_USER=root
DB_PASS=""

# Fuso orario usato per date, ore e file ICS.
APP_TIMEZONE="Europe/Rome"

# Codice per la pagina di primo avvio /installazione, che crea le tabelle
# e il primo amministratore dal browser. Serve sugli hosting senza
# Terminal, dove non si possono lanciare migrate.php e crea-admin.php.
#
# Metti una stringa lunga a caso. La pagina funziona solo finche non
# esiste nessun account: dopo l'installazione questa riga si puo
# togliere.
SETUP_TOKEN=""
